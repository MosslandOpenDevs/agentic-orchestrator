# Availability-monitor host addresses (real values in CLAUDE.local.md)
scripts/monitor/local.env

# Application data (SQLite DB and backups - never commit).
# The glob matters as much as the exact names: restore-db leaves
# orchestrator.db.pre-restore-<timestamp> beside the database (a full copy of
# production), and a failed restore can leave orchestrator.db.restore-tmp.
data/orchestrator.db
data/orchestrator.db-journal
data/orchestrator.db-wal
data/orchestrator.db-shm
data/orchestrator.db.*
data/backup/

# Async job state
data/jobs.json
data/orchestrator.db.bak*

# Adapter runtime state — written by the SignalMap poller (cursor, watermark,
# last_success_at). Machine-local and per-deployment; committing it would let
# one box's cursor overwrite another's.
data/signalmap_state.json

# Auto-generated project scaffolds (LLM output, not hand-authored source).
# Regenerated from plans on demand; keeping them out of git avoids repo bloat.
# Anchored to the repo root so it does NOT also ignore nested dirs such as
# website/src/app/projects/ (the frontend Projects page).
/projects/
# uv.lock is TRACKED: CI and production must install the same dependency
# graph for a given commit, and an ignored lock meant each machine resolved
# its own (pyproject pins mostly lower bounds).
