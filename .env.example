# =============================================================================
# Mossland Agentic Orchestrator - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------

# Anthropic API Key (for Claude API direct calls)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (for GPT models - review/evaluation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# Google Gemini API Key (for Gemini models - review/evaluation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxx

# -----------------------------------------------------------------------------
# Local LLM (Ollama) — REQUIRED for debate / planning workers
# -----------------------------------------------------------------------------

# Host URL of the Ollama server. Required by the PM2 schedulers
# (debate / trends / backlog) and by ContentTranslator. Without this,
# OllamaProvider falls back to http://localhost:11434, which is almost
# never what you want in production — every model call will return 404
# and the planning phase will produce empty plans.
#
# ecosystem.config.js parses this file directly, so just setting the
# variable here is enough — no need to also export it in your shell.
OLLAMA_HOST=http://localhost:11434

# When unset or truthy (default), HybridLLMRouter refuses to instantiate
# Claude / OpenAI / Gemini providers and forces every request to local
# Ollama models. Set to "false" to re-enable hybrid (billed) routing.
MOSS_LOCAL_LLM_ONLY=true

# -----------------------------------------------------------------------------
# GitHub (set on an auto-deploy server)
# -----------------------------------------------------------------------------

# Read by the deploy's CI status query (scripts/deploy.sh) and the GitHub Events
# signal adapter. Both only GET public data, so the token needs no write access:
# it lifts GitHub's anonymous per-IP rate limit. deploy.sh treats a 401/403 from the CI
# query as a blocked deploy: without a token, while the server IP's anonymous quota (which
# the adapter then shares) is used up; with a rejected token, on every tick.
# Create at: https://github.com/settings/tokens
# GITHUB_TOKEN=

# Git user configuration (for commits)
GIT_USER_NAME=Agentic Orchestrator
GIT_USER_EMAIL=orchestrator@mossland.org

# -----------------------------------------------------------------------------
# SignalMap export feed (optional)
# -----------------------------------------------------------------------------

# Override the SignalMap host the signal adapter reads. Defaults to the value in
# config.yaml (https://signalmap.moss.land). Point this at a staging instance to
# test against a different corpus — note that a different host means a different
# `epoch`, which correctly forces a full resync.
# SIGNALMAP_BASE_URL=https://signalmap.moss.land

# Bearer token for the export endpoints. The export is open today (it carries
# only what is already public on signalmap.moss.land), so this is unset; when
# the publisher sets its AO_EXPORT_TOKEN, setting this is the whole migration.
# SIGNALMAP_EXPORT_TOKEN=

# -----------------------------------------------------------------------------
# Orchestrator Configuration
# -----------------------------------------------------------------------------

# Default Claude model for development tasks
# Options: opus, sonnet (opus recommended for complex tasks)
CLAUDE_MODEL=opus

# OpenAI model for review/evaluation
# Default: gpt-5.2-chat-latest (latest), Fallback: gpt-5.2
OPENAI_MODEL=gpt-5.2-chat-latest
OPENAI_MODEL_FALLBACK=gpt-5.2

# Gemini model for review/evaluation
# Default: gemini-3-flash-preview (fast), Fallback: gemini-3-pro-preview
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-3-pro-preview

# Pinned model versions for reproducibility (optional)
# Set these to use specific model versions instead of latest
# OPENAI_MODEL_PINNED=gpt-5.2-0601
# GEMINI_MODEL_PINNED=gemini-3-flash-001

# -----------------------------------------------------------------------------
# Execution Limits
# -----------------------------------------------------------------------------

# Maximum planning iterations before escalation
PLANNING_MAX_ITERATIONS=3

# Maximum development iterations before escalation
DEV_MAX_ITERATIONS=5

# Rate limit retry settings
RATE_LIMIT_MAX_RETRIES=5
RATE_LIMIT_MAX_WAIT_SECONDS=3600

# Loop mode settings
LOOP_MAX_STEPS=100
LOOP_DELAY_SECONDS=10

# -----------------------------------------------------------------------------
# Dry Run Mode
# -----------------------------------------------------------------------------

# Set to 'true' to run without making actual API calls
# Useful for testing the orchestrator logic
DRY_RUN=false

# -----------------------------------------------------------------------------
# API Server Security
# -----------------------------------------------------------------------------

# Required: shared secret for mutating endpoints (X-API-Key header).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without this set, /plans/{id}/approve and /plans/{id}/generate-project
# return 503 Service Unavailable.
MOSS_API_KEY=

# Let the public dashboard's "generate project" button spend MOSS_API_KEY.
# The Next.js proxy at /proxy/plans/{id}/generate-project runs with the
# operator's key, and ao.moss.land has no user accounts — so with this on,
# any visitor can start an LLM generation (GPU time, DB and disk writes).
# Off by default; approve has no proxy at all and is operator-only.
#
# Note what the route's same-origin check is and is not: it is CSRF
# protection for browser callers. Any non-browser client can send whatever
# headers it likes, so with this flag ON, an anonymous caller can drive
# generation at the rate limit. Only enable it if that is acceptable.
# MOSS_ENABLE_BROWSER_PROJECT_GENERATION=1

# Origin the dashboard is served from, used by that same-origin check.
# MOSS_PUBLIC_ORIGIN=https://ao.moss.land

# Comma-separated CORS origins allowed to call the API.
# Default: https://ao.moss.land,http://localhost:3000,http://127.0.0.1:3000
# MOSS_CORS_ORIGINS=https://ao.moss.land,http://localhost:3000
