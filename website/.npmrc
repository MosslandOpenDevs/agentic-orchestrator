# npm treats NODE_ENV=production as --omit=dev. The deploy poller runs under PM2
# with NODE_ENV=production, so `npm ci` installed 45 of 382 packages and every
# `next build` died on a missing devDependency (2026-08-06). This site is built
# from source on the server, so devDependencies are never optional here.
#
# scripts/deploy.sh passes --include=dev too, but that flag cannot rescue a
# server already stuck: bash parses the whole script at startup, so a failing
# deploy runs the OLD deploy.sh against the NEW checkout. This file lives in the
# checkout, so it applies on the very first attempt.
include=dev
