# NOTE: keys were AO_MONITOR_* until this tool started backing more than one
# service. Both spellings are read; MONITOR_* wins if a file has both. An
# existing config.env needs no edit.
#
# AO availability monitor -- copy to ~/ao-monitor/config.env on each box.
#
# This file holds a secret (the Discord webhook), so it is NOT tracked in git
# and must not be world-readable:  chmod 600 ~/ao-monitor/config.env

# ---------------------------------------------------------------------------
# probe_uptime.py  (Lightsail / nginx host -- outside the office network)
# ---------------------------------------------------------------------------

# What the outside probe watches. This is the app server's tailnet address and
# port, i.e. exactly what nginx proxies ao.moss.land to. Probing the public URL
# instead would fold nginx's own health into the measurement.
#
# REQUIRED. The real address is deliberately not in this public repo -- see
# CLAUDE.local.md. The probe refuses to run while this is unset.
MONITOR_TARGET=http://<app-server-tailnet-ip>:3001/health

# Seconds before a probe is called a failure. nginx's own proxy timeout is 60s,
# but a healthy /health answers in ~40ms; 5s is generous and keeps a stalled
# probe from overlapping the next cron tick.
MONITOR_TIMEOUT=5

# Service name used in alert titles: "🔴 <label> 앱 서버 DOWN".
#
# One copy of probe_uptime.py can back several instances -- `--dir` gives each
# its own config.env, data/ and webhook -- so a hardcoded name puts "AO" on
# every channel's alerts and the reader has to know which cron wrote the
# message to tell what is actually down. Defaults to AO, so an existing
# config.env keeps its current titles.
MONITOR_LABEL=AO

# Discord incoming webhook. Server settings -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL. Leave empty to record without alerting.
MONITOR_DISCORD_WEBHOOK=

# ---------------------------------------------------------------------------
# probe_netpath.py  (office VM -- inside, on the failing side)
# ---------------------------------------------------------------------------

# Blank means auto-detect from `ip route`. Set it only if the VM has more than
# one default route and the detection picks the wrong one.
MONITOR_GATEWAY=

# Reached by raw IP so that the internet check never depends on DNS -- that
# separation is the whole point of the layered probe.
MONITOR_INTERNET_IP=1.1.1.1

# Resolved through systemd-resolved, the same path the application uses.
MONITOR_DNS_NAME=github.com

# The Lightsail node's tailnet IP: the exact data path nginx traverses in
# reverse, so a tunnel failure is distinguishable from a line failure.
#
# REQUIRED. Real address in CLAUDE.local.md; the probe refuses to run while
# this is unset (recording with it unset would blame the tunnel for every
# outage).
MONITOR_TS_PEER=<lightsail-tailnet-ip>
